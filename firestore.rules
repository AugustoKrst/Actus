rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validGoal(goal) {
      return goal in ['Ganhar força', 'Ter mais disposição', 'Criar uma rotina', 'Melhorar mobilidade'];
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'goal', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && validGoal(request.resource.data.goal);
      allow update: if owns(userId)
        && request.resource.data.keys().hasOnly(['name', 'email', 'goal', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email == resource.data.email
        && validGoal(request.resource.data.goal);
      allow delete: if false;

      match /workouts/{workoutId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && request.resource.data.keys().hasOnly(['title', 'muscle', 'place', 'equipment', 'duration', 'level', 'exercises', 'completedExerciseIds', 'completedAt', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.equipment is list
          && request.resource.data.exercises is list
          && request.resource.data.exercises.size() > 0
          && request.resource.data.exercises.size() <= 20
          && request.resource.data.completedExerciseIds is list
          && request.resource.data.completedExerciseIds.size() == 0
          && request.resource.data.completedAt == null
          && request.resource.data.duration in [20, 30, 45, 60]
          && request.resource.data.level in ['Iniciante', 'Intermediário', 'Avançado'];
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedExerciseIds', 'completedAt'])
          && request.resource.data.completedExerciseIds is list
          && request.resource.data.completedExerciseIds.size() <= resource.data.exercises.size()
          && (request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp);
        allow delete: if owns(userId);
      }
    }
  }
}
